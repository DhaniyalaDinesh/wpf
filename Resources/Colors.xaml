<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand / Accent Colors (Windows 11 Fluent Blue) -->
    <Color x:Key="Color_Accent_Light">#0067C0</Color>
    <Color x:Key="Color_Accent_Dark">#4CC2FF</Color>
    <Color x:Key="Color_Accent_Hover_Light">#1879CD</Color>
    <Color x:Key="Color_Accent_Hover_Dark">#60CDFF</Color>

    <!-- Semantic Status Colors -->
    <!-- Good / Success -->
    <Color x:Key="Color_Success">#107C41</Color>
    <Color x:Key="Color_Success_Dark">#54B054</Color>
    <Color x:Key="Color_Success_Bg_Light">#EBF3EE</Color>
    <Color x:Key="Color_Success_Bg_Dark">#1A3324</Color>

    <!-- Warning / Attention -->
    <Color x:Key="Color_Warning">#C25400</Color>
    <Color x:Key="Color_Warning_Dark">#FCE100</Color>
    <Color x:Key="Color_Warning_Bg_Light">#FFF4CE</Color>
    <Color x:Key="Color_Warning_Bg_Dark">#3E3310</Color>

    <!-- Error / Critical -->
    <Color x:Key="Color_Error">#C42B1C</Color>
    <Color x:Key="Color_Error_Dark">#FF99A4</Color>
    <Color x:Key="Color_Error_Bg_Light">#FDF3F2</Color>
    <Color x:Key="Color_Error_Bg_Dark">#3B181A</Color>

    <!-- Informational -->
    <Color x:Key="Color_Info">#005FB8</Color>
    <Color x:Key="Color_Info_Dark">#60CDFF</Color>
    <Color x:Key="Color_Info_Bg_Light">#EBF3FC</Color>
    <Color x:Key="Color_Info_Bg_Dark">#14293E</Color>

</ResourceDictionary>
