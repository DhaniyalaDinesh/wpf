<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Windows 11 Dark Theme Brushes -->
    <SolidColorBrush x:Key="Brush_AppBackground" Color="#202020" />
    <SolidColorBrush x:Key="Brush_NavBackground" Color="#262626" />
    <SolidColorBrush x:Key="Brush_HeaderBackground" Color="#242424" />
    <SolidColorBrush x:Key="Brush_CardBackground" Color="#2B2B2B" />
    <SolidColorBrush x:Key="Brush_CardBackgroundSecondary" Color="#323232" />
    <SolidColorBrush x:Key="Brush_CardBackgroundHover" Color="#383838" />
    <SolidColorBrush x:Key="Brush_CardBorder" Color="#383838" />
    <SolidColorBrush x:Key="Brush_CardBorderSubtle" Color="#2E2E2E" />
    <SolidColorBrush x:Key="Brush_Separator" Color="#333333" />

    <!-- Typography Brushes -->
    <SolidColorBrush x:Key="Brush_TextPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush_TextSecondary" Color="#CCCCCC" />
    <SolidColorBrush x:Key="Brush_TextTertiary" Color="#888888" />

    <!-- Brand / Accent -->
    <SolidColorBrush x:Key="Brush_Accent" Color="#4CC2FF" />
    <SolidColorBrush x:Key="Brush_AccentHover" Color="#64CEFF" />
    <SolidColorBrush x:Key="Brush_AccentPressed" Color="#3BB5F2" />
    <SolidColorBrush x:Key="Brush_AccentText" Color="#000000" />
    <SolidColorBrush x:Key="Brush_AccentSubtleBg" Color="#1E3345" />

    <!-- Controls -->
    <SolidColorBrush x:Key="Brush_SearchBackground" Color="#2E2E2E" />
    <SolidColorBrush x:Key="Brush_SearchBorder" Color="#3D3D3D" />
    <SolidColorBrush x:Key="Brush_ButtonSecondaryBackground" Color="#333333" />
    <SolidColorBrush x:Key="Brush_ButtonSecondaryBorder" Color="#454545" />
    <SolidColorBrush x:Key="Brush_ButtonSecondaryHover" Color="#3D3D3D" />

    <!-- Navigation -->
    <SolidColorBrush x:Key="Brush_NavHover" Color="#FFFFFF0E" />
    <SolidColorBrush x:Key="Brush_NavSelected" Color="#FFFFFF19" />
    <SolidColorBrush x:Key="Brush_NavSelectedIndicator" Color="#4CC2FF" />
    <SolidColorBrush x:Key="Brush_NavTextSelected" Color="#4CC2FF" />

    <!-- Semantic Status -->
    <SolidColorBrush x:Key="Brush_StatusGood" Color="#54B054" />
    <SolidColorBrush x:Key="Brush_StatusGoodBg" Color="#183623" />
    <SolidColorBrush x:Key="Brush_StatusGoodBorder" Color="#285C38" />

    <SolidColorBrush x:Key="Brush_StatusWarning" Color="#FCE100" />
    <SolidColorBrush x:Key="Brush_StatusWarningBg" Color="#3E3410" />
    <SolidColorBrush x:Key="Brush_StatusWarningBorder" Color="#665415" />

    <SolidColorBrush x:Key="Brush_StatusError" Color="#FF99A4" />
    <SolidColorBrush x:Key="Brush_StatusErrorBg" Color="#3D181B" />
    <SolidColorBrush x:Key="Brush_StatusErrorBorder" Color="#6B282E" />

    <SolidColorBrush x:Key="Brush_StatusInfo" Color="#60CDFF" />
    <SolidColorBrush x:Key="Brush_StatusInfoBg" Color="#152B3E" />
    <SolidColorBrush x:Key="Brush_StatusInfoBorder" Color="#234E73" />

    <SolidColorBrush x:Key="Brush_ProgressBarBackground" Color="#383838" />
    <SolidColorBrush x:Key="Brush_AvatarBackground" Color="#4CC2FF" />
    <SolidColorBrush x:Key="Brush_AvatarText" Color="#000000" />

</ResourceDictionary>
