<UserControl x:Class="WPFUI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:WPFUI.Converters"
             xmlns:vm="clr-namespace:WPFUI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:HomeViewModel}"
             d:DesignHeight="1200" d:DesignWidth="1000">

    <UserControl.Resources>
        <converters:SeverityToBrushConverter x:Key="SeverityToBrushConverter" />
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
        <StackPanel Margin="32,24,32,36">

            <!-- ========================================== -->
            <!-- 1. WELCOME SECTION                         -->
            <!-- ========================================== -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Greeting}" 
                               FontSize="26" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource Brush_TextPrimary}" />
                    <TextBlock Text="{Binding Subtitle}" 
                               FontSize="13" 
                               Margin="0,4,0,0" 
                               Foreground="{DynamicResource Brush_TextSecondary}" />
                </StackPanel>

                <!-- Device Info & Last Updated Pill -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource Brush_CardBackground}"
                            BorderBrush="{DynamicResource Brush_CardBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon_MyPC}" 
                                  Width="14" Height="14" 
                                  Stretch="Uniform" 
                                  Fill="{DynamicResource Brush_TextSecondary}" 
                                  VerticalAlignment="Center" 
                                  Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource Str_Home_DeviceBadge}" 
                                       FontWeight="Bold" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource Brush_TextTertiary}" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,5,0" />
                            <TextBlock Text="{Binding DeviceName}" 
                                       FontWeight="SemiBold" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource Brush_TextPrimary}" 
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Refresh Button -->
                    <Button Style="{StaticResource ModernSecondaryButton}"
                            Command="{Binding RefreshCommand}"
                            ToolTip="Refresh Health Telemetry"
                            Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon_WindowsUpdate}" 
                                  Width="12" Height="12" 
                                  Stretch="Uniform" 
                                  Fill="{DynamicResource Brush_TextSecondary}" 
                                  VerticalAlignment="Center" 
                                  Margin="0,0,6,0" />
                            <TextBlock Text="{Binding LastUpdatedText}" 
                                       FontSize="11" 
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ========================================== -->
            <!-- 2. OVERALL PC HEALTH (Prominent Card)      -->
            <!-- ========================================== -->
            <Border Style="{StaticResource SummaryCardBorder}" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Health Score Ring / Badge -->
                    <Border Grid.Column="0" 
                            Width="74" Height="74" 
                            CornerRadius="37" 
                            Background="{DynamicResource Brush_StatusGoodBg}"
                            BorderBrush="{DynamicResource Brush_StatusGoodBorder}"
                            BorderThickness="2"
                            Margin="0,0,20,0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding HealthScore, StringFormat='{}{0}%'}" 
                                       FontSize="20" 
                                       FontWeight="Bold" 
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Brush_StatusGood}" />
                            <TextBlock Text="Score" 
                                       FontSize="10" 
                                       FontWeight="SemiBold" 
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Brush_StatusGood}" />
                        </StackPanel>
                    </Border>

                    <!-- Health Details -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{DynamicResource Str_Overall_Title}" 
                                       FontSize="17" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource Brush_TextPrimary}" 
                                       VerticalAlignment="Center" />
                            <!-- Status Pill -->
                            <Border Background="{DynamicResource Brush_StatusGoodBg}"
                                    BorderBrush="{DynamicResource Brush_StatusGoodBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,2"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush_StatusGood}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding HealthStatusText}" 
                                               FontSize="11" 
                                               FontWeight="SemiBold" 
                                               Foreground="{DynamicResource Brush_StatusGood}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding HealthSummaryText}" 
                                   FontSize="13" 
                                   Foreground="{DynamicResource Brush_TextSecondary}" 
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Quick Subsystems Indicator on right -->
                    <Border Grid.Column="2" 
                            Background="{DynamicResource Brush_CardBackgroundSecondary}" 
                            CornerRadius="6" 
                            Padding="14,10" 
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon_CheckCircle}" 
                                  Width="18" Height="18" 
                                  Stretch="Uniform" 
                                  Fill="{DynamicResource Brush_StatusGood}" 
                                  VerticalAlignment="Center" 
                                  Margin="0,0,8,0" />
                            <StackPanel>
                                <TextBlock Text="Subsystems Active" 
                                           FontWeight="SemiBold" 
                                           FontSize="12" 
                                           Foreground="{DynamicResource Brush_TextPrimary}" />
                                <TextBlock Text="6 of 6 Monitored" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource Brush_TextSecondary}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- 3. DEVICE HEALTH CARDS (6 Cards Grid)      -->
            <!-- ========================================== -->
            <TextBlock Text="System Subsystems" 
                       FontSize="16" 
                       FontWeight="SemiBold" 
                       Foreground="{DynamicResource Brush_TextPrimary}" 
                       Margin="0,0,0,12" />

            <ItemsControl ItemsSource="{Binding HealthCards}" Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,12,12">
                            <StackPanel>
                                <!-- Card Header (Icon, Title, Status Tag) -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Subsystem Icon -->
                                    <Border Grid.Column="0" 
                                            Width="32" Height="32" 
                                            CornerRadius="6" 
                                            Background="{DynamicResource Brush_CardBackgroundSecondary}"
                                            Margin="0,0,10,0">
                                        <Path Data="{Binding IconResourceKey, Converter={x:Null}}" 
                                              Width="16" Height="16" 
                                              Stretch="Uniform" 
                                              Fill="{DynamicResource Brush_Accent}" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IconResourceKey}" Value="Icon_Disk">
                                                            <Setter Property="Data" Value="{StaticResource Icon_Disk}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IconResourceKey}" Value="Icon_Antivirus">
                                                            <Setter Property="Data" Value="{StaticResource Icon_Antivirus}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IconResourceKey}" Value="Icon_BitLocker">
                                                            <Setter Property="Data" Value="{StaticResource Icon_BitLocker}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IconResourceKey}" Value="Icon_Battery">
                                                            <Setter Property="Data" Value="{StaticResource Icon_Battery}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IconResourceKey}" Value="Icon_WindowsUpdate">
                                                            <Setter Property="Data" Value="{StaticResource Icon_WindowsUpdate}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IconResourceKey}" Value="Icon_Agent">
                                                            <Setter Property="Data" Value="{StaticResource Icon_Agent}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Border>

                                    <!-- Title -->
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding Title}" 
                                               FontWeight="SemiBold" 
                                               FontSize="13" 
                                               VerticalAlignment="Center" 
                                               Foreground="{DynamicResource Brush_TextPrimary}" />

                                    <!-- Status Badge -->
                                    <Border Grid.Column="2" 
                                            Background="{Binding StatusLevel, Converter={StaticResource StatusToBrushConverter}, ConverterParameter=Background}" 
                                            CornerRadius="4" 
                                            Padding="6,2" 
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" 
                                                   FontSize="10" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{Binding StatusLevel, Converter={StaticResource StatusToBrushConverter}}" />
                                    </Border>
                                </Grid>

                                <!-- Primary Value -->
                                <TextBlock Text="{Binding PrimaryValue}" 
                                           FontSize="18" 
                                           FontWeight="SemiBold" 
                                           Foreground="{DynamicResource Brush_TextPrimary}" 
                                           Margin="0,0,0,4" />

                                <!-- Subtitle / Detail -->
                                <TextBlock Text="{Binding Subtitle}" 
                                           FontSize="12" 
                                           Foreground="{DynamicResource Brush_TextSecondary}" 
                                           Margin="0,0,0,8" />

                                <!-- Progress Bar if applicable -->
                                <ProgressBar Style="{StaticResource ModernProgressBar}" 
                                             Value="{Binding ProgressValue}" 
                                             Visibility="{Binding ShowProgressBar, Converter={StaticResource BooleanToVisibilityConverter}}" 
                                             Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ========================================== -->
            <!-- 4. SUGGESTED FIXES                         -->
            <!-- ========================================== -->
            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Str_Section_SuggestedFixes}" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource Brush_TextPrimary}" />
                    <TextBlock Text="{DynamicResource Str_Section_SuggestedFixes_Subtitle}" 
                               FontSize="12" 
                               Foreground="{DynamicResource Brush_TextSecondary}" />
                </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding SuggestedFixes}" Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header: Icon + Category + Duration -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" 
                                            Width="32" Height="32" 
                                            CornerRadius="6" 
                                            Background="{DynamicResource Brush_AccentSubtleBg}"
                                            Margin="0,0,8,0">
                                        <Path Width="16" Height="16" 
                                              Stretch="Uniform" 
                                              Fill="{DynamicResource Brush_Accent}" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IconResourceKey}" Value="Icon_Broom">
                                                            <Setter Property="Data" Value="{StaticResource Icon_Broom}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IconResourceKey}" Value="Icon_WindowsUpdate">
                                                            <Setter Property="Data" Value="{StaticResource Icon_WindowsUpdate}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IconResourceKey}" Value="Icon_Network">
                                                            <Setter Property="Data" Value="{StaticResource Icon_Network}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Border>

                                    <!-- Category Pill -->
                                    <Border Grid.Column="1" 
                                            HorizontalAlignment="Left" 
                                            Background="{DynamicResource Brush_CardBackgroundSecondary}" 
                                            CornerRadius="4" 
                                            Padding="6,2" 
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Category}" 
                                                   FontSize="10" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource Brush_TextTertiary}" />
                                    </Border>

                                    <!-- Estimated Duration Badge -->
                                    <Border Grid.Column="2" 
                                            Visibility="{Binding HasEstimatedDuration, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Background="{DynamicResource Brush_CardBackgroundSecondary}" 
                                            CornerRadius="4" 
                                            Padding="6,2" 
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon_ClockWait}" 
                                                  Width="10" Height="10" 
                                                  Stretch="Uniform" 
                                                  Fill="{DynamicResource Brush_TextSecondary}" 
                                                  Margin="0,0,4,0" 
                                                  VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding EstimatedDurationText}" 
                                                       FontSize="10" 
                                                       Foreground="{DynamicResource Brush_TextSecondary}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Body: Name & Description -->
                                <StackPanel Grid.Row="1" Margin="0,0,0,14">
                                    <TextBlock Text="{Binding Name}" 
                                               FontSize="14" 
                                               FontWeight="SemiBold" 
                                               Foreground="{DynamicResource Brush_TextPrimary}" 
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding Description}" 
                                               FontSize="12" 
                                               Foreground="{DynamicResource Brush_TextSecondary}" 
                                               TextWrapping="Wrap" 
                                               MaxHeight="48" 
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Actions: View & Fix Buttons -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" 
                                            Style="{StaticResource ModernSecondaryButton}" 
                                            Content="{DynamicResource Str_Btn_View}" 
                                            Command="{Binding ViewCommand}" />

                                    <Button Grid.Column="2" 
                                            Style="{StaticResource ModernPrimaryButton}" 
                                            Content="{DynamicResource Str_Btn_Fix}" 
                                            Command="{Binding FixCommand}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ========================================== -->
            <!-- 5. TOP ALERTS                              -->
            <!-- ========================================== -->
            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Str_Section_TopAlerts}" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource Brush_TextPrimary}" />
                    <TextBlock Text="{DynamicResource Str_Section_TopAlerts_Subtitle}" 
                               FontSize="12" 
                               Foreground="{DynamicResource Brush_TextSecondary}" />
                </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding TopAlerts}" Margin="0,0,0,24">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Severity Icon / Accent Left Bar -->
                                <Border Grid.Column="0" 
                                        Width="32" Height="32" 
                                        CornerRadius="16" 
                                        Background="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}, ConverterParameter=Background}"
                                        Margin="0,0,14,0" 
                                        VerticalAlignment="Center">
                                    <Path Width="14" Height="14" 
                                          Stretch="Uniform" 
                                          Fill="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}}" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="{StaticResource Icon_InfoCircle}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                        <Setter Property="Data" Value="{StaticResource Icon_WarningTriangle}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                        <Setter Property="Data" Value="{StaticResource Icon_ErrorCircle}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                        <Setter Property="Data" Value="{StaticResource Icon_ErrorCircle}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Border>

                                <!-- Alert Content -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <!-- Severity Pill -->
                                        <Border Background="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}, ConverterParameter=Background}" 
                                                CornerRadius="4" 
                                                Padding="6,1" 
                                                Margin="0,0,8,0" 
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SeverityText}" 
                                                       FontSize="10" 
                                                       FontWeight="Bold" 
                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityToBrushConverter}}" />
                                        </Border>
                                        <!-- Alert Title -->
                                        <TextBlock Text="{Binding Title}" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="13" 
                                                   Foreground="{DynamicResource Brush_TextPrimary}" 
                                                   VerticalAlignment="Center" />
                                        <!-- Time ago -->
                                        <TextBlock Text="{Binding TimeAgoText, StringFormat='{} • {0}'}" 
                                                   FontSize="11" 
                                                   Foreground="{DynamicResource Brush_TextTertiary}" 
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding Description}" 
                                               FontSize="12" 
                                               Foreground="{DynamicResource Brush_TextSecondary}" 
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button Style="{StaticResource ModernPrimaryButton}" 
                                            Content="Run Fix"
                                            Visibility="{Binding HasSuggestedAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Command="{Binding FixCommand}" 
                                            Margin="0,0,8,0" 
                                            Padding="12,5" 
                                            FontSize="12" />

                                    <Button Style="{StaticResource ModernSecondaryButton}" 
                                            Content="{DynamicResource Str_Btn_Dismiss}" 
                                            Command="{Binding DismissCommand}" 
                                            CommandParameter="{Binding}" 
                                            Padding="10,5" 
                                            FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ============================================================== -->
            <!-- 6. RECENT ACTIVITY & 7. WINDOWS UPDATE SUMMARY (2 COLUMNS)     -->
            <!-- ============================================================== -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Recent Activity Table -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="{DynamicResource Str_Section_RecentActivity}" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource Brush_TextPrimary}" />
                    <TextBlock Text="{DynamicResource Str_Section_RecentActivity_Subtitle}" 
                               FontSize="12" 
                               Foreground="{DynamicResource Brush_TextSecondary}" 
                               Margin="0,0,0,10" />

                    <Border Style="{StaticResource CardBorder}" Padding="0">
                        <StackPanel>
                            <!-- Table Header -->
                            <Border Background="{DynamicResource Brush_CardBackgroundSecondary}" 
                                    BorderBrush="{DynamicResource Brush_CardBorderSubtle}" 
                                    BorderThickness="0,0,0,1" 
                                    Padding="16,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.5*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Str_Th_Action}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Brush_TextTertiary}" />
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Str_Th_DateTime}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Brush_TextTertiary}" />
                                    <TextBlock Grid.Column="2" Text="{DynamicResource Str_Th_Status}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Brush_TextTertiary}" />
                                    <TextBlock Grid.Column="3" Text="{DynamicResource Str_Th_Duration}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Brush_TextTertiary}" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>

                            <!-- Table Rows -->
                            <ItemsControl ItemsSource="{Binding RecentActivities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Brush_CardBorderSubtle}" 
                                                BorderThickness="0,0,0,1" 
                                                Padding="16,11">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.5*" />
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Action Name + Category -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ActionName}" 
                                                               FontWeight="Medium" 
                                                               FontSize="13" 
                                                               Foreground="{DynamicResource Brush_TextPrimary}" />
                                                    <TextBlock Text="{Binding Category}" 
                                                               FontSize="10" 
                                                               Foreground="{DynamicResource Brush_TextTertiary}" />
                                                </StackPanel>

                                                <!-- Date & Time -->
                                                <TextBlock Grid.Column="1" 
                                                           Text="{Binding FormattedDateTime}" 
                                                           FontSize="12" 
                                                           Foreground="{DynamicResource Brush_TextSecondary}" 
                                                           VerticalAlignment="Center" />

                                                <!-- Status Badge -->
                                                <Border Grid.Column="2" 
                                                        HorizontalAlignment="Left"
                                                        Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}, ConverterParameter=Background}" 
                                                        CornerRadius="4" 
                                                        Padding="6,2" 
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FriendlyStatusText}" 
                                                               FontSize="11" 
                                                               FontWeight="SemiBold" 
                                                               Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" />
                                                </Border>

                                                <!-- Duration -->
                                                <TextBlock Grid.Column="3" 
                                                           Text="{Binding DurationText}" 
                                                           FontSize="12" 
                                                           Foreground="{DynamicResource Brush_TextSecondary}" 
                                                           HorizontalAlignment="Right" 
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column: Windows Update Summary Card -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource Str_Section_WindowsUpdate}" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource Brush_TextPrimary}" />
                    <TextBlock Text="System patch compliance" 
                               FontSize="12" 
                               Foreground="{DynamicResource Brush_TextSecondary}" 
                               Margin="0,0,0,10" />

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <!-- Windows Update Visual Banner -->
                            <Border Background="{DynamicResource Brush_AccentSubtleBg}" 
                                    CornerRadius="6" 
                                    Padding="14,12" 
                                    Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon_WindowsUpdate}" 
                                          Width="22" Height="22" 
                                          Stretch="Uniform" 
                                          Fill="{DynamicResource Brush_Accent}" 
                                          VerticalAlignment="Center" 
                                          Margin="0,0,12,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding UpdateStatusText}" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="14" 
                                                   Foreground="{DynamicResource Brush_TextPrimary}" />
                                        <TextBlock Text="Device is compliant with IT policies" 
                                                   FontSize="11" 
                                                   Foreground="{DynamicResource Brush_TextSecondary}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Pending Updates:" FontSize="12" Foreground="{DynamicResource Brush_TextSecondary}" />
                                <TextBlock Text="{Binding PendingUpdatesCount, StringFormat='{}{0} required'}" 
                                           HorizontalAlignment="Right" 
                                           FontWeight="SemiBold" 
                                           FontSize="12" 
                                           Foreground="{DynamicResource Brush_TextPrimary}" />
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="Last Checked:" FontSize="12" Foreground="{DynamicResource Brush_TextSecondary}" />
                                <TextBlock Text="{Binding LastCheckedText}" 
                                           HorizontalAlignment="Right" 
                                           FontSize="12" 
                                           Foreground="{DynamicResource Brush_TextPrimary}" />
                            </Grid>

                            <Button Style="{StaticResource ModernSecondaryButton}" 
                                    Content="{DynamicResource Str_Btn_CheckUpdates}" 
                                    Command="{Binding CheckUpdatesCommand}" 
                                    HorizontalAlignment="Stretch" 
                                    Padding="0,8" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
